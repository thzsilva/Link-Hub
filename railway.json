{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "cd artifacts/api-server && node ./dist/index.mjs",
    "healthchecks": {
      "enabled": true,
      "endpoint": "/api/healthz"
    }
  }
}
