{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "concurrently --names \"API,WEB\" --prefix-colors \"cyan,yellow\" --kill-others-on-fail \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=artifacts/api-server",
    "dev:web": "npm run dev --workspace=artifacts/void",
    "seed": "tsx scripts/src/seed.ts",
    "build": "npm run typecheck && npm run build --workspaces --if-present",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs && npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
}
